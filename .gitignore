node_modules/
dist/
build/
coverage/
*.tsbuildinfo

.env
.env.*
# Arquivo de exemplo não carrega segredo — carrega os nomes das variáveis, que
# é o que precisa estar versionado. A negação cobre qualquer
# `.env.<ambiente>.example`, e não só o `.env.example`: sem ela cada exemplo
# novo exigiria `git add -f`, e o primeiro que alguém esquecesse sumiria do
# repositório sem aviso nenhum.
!.env.example
!.env.*.example

.DS_Store
*.log
npm-debug.log*

.idea/
.vscode/

# Saída do gerador de tema. Nasce dos tokens a cada build, como o dist —
# versioná-la criaria uma segunda cópia da paleta, livre para divergir.
apps/web/src/estilos/tema.gerado.css
