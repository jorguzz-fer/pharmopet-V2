{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ESM: um bundler não consegue ler os nomes exportados de um re-export
    // CommonJS, e o build da web quebra dizendo que o token "não é exportado".
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*"]
}
