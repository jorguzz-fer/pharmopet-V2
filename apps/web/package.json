{
  "name": "@pharmopet/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Front web da PharmoPet — React, mobile-first",
  "scripts": {
    "gerar:tema": "node scripts/gerar-tema.mjs",
    "dev": "pnpm gerar:tema && vite",
    "build": "pnpm gerar:tema && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm gerar:tema && tsc -p tsconfig.json --noEmit",
    "test": "pnpm gerar:tema && vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/manrope": "^5.2.9",
    "@pharmopet/api-client": "workspace:*",
    "@pharmopet/design-tokens": "workspace:*",
    "@pharmopet/shared": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.9.6",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}
