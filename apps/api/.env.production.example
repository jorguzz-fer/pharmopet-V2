# Ambiente de produção da API.
#
# Copie os nomes daqui para o painel do Coolify. Este arquivo não vai para a
# imagem (o .dockerignore barra .env) e não deve receber valor real nenhum.
#
# O boot valida tudo isto em apps/api/src/config/env.ts e recusa subir com
# configuração inválida — falhar no start, com mensagem, é melhor do que
# descobrir em runtime num caminho qualquer.

NODE_ENV=production
PORT=3000

# URL interna do Postgres do Coolify, não a pública: o banco não precisa estar
# exposto na internet. Senha com @ # ? / precisa vir percent-encoded, senão a
# URL quebra antes de chegar ao banco.
DATABASE_URL=postgresql://usuario:senha@nome-interno-do-servico:5432/pharmopet

# Origens de navegador liberadas, separadas por vírgula. Com NODE_ENV=production
# e isto vazio, o processo NÃO SOBE — sem origem nenhuma, nenhum navegador
# conseguiria falar com a API, e subir assim só adiaria a descoberta.
#
# Precisa ser o mesmo domínio registrável do front: o cookie de sessão é
# SameSite=Lax, e entre domínios diferentes o navegador não o envia.
ALLOWED_ORIGINS=https://app.seudominio.com.br

# Quanto tempo a sessão vale sem renovação. Doze horas cobrem um plantão
# inteiro sem pedir senha no meio de um atendimento.
SESSAO_DURACAO_HORAS=12

# Com NODE_ENV=production, `false` aqui também impede o boot: entregaria o
# cookie de sessão em texto claro na primeira requisição HTTP.
COOKIE_SEGURO=true
