# Ambiente
NODE_ENV=development
PORT=3000

# Banco — o compose local sobe exatamente estas credenciais
DATABASE_URL=postgresql://pharmopet:pharmopet@localhost:5432/pharmopet

# Origens liberadas para o navegador, separadas por vírgula.
# Vazio = nenhuma origem de browser é aceita.
ALLOWED_ORIGINS=http://localhost:5173

# Quanto tempo a sessão vale sem renovação. Doze horas cobrem um plantão.
SESSAO_DURACAO_HORAS=12

# Marca o cookie de sessão como Secure, e aí o navegador só o envia por HTTPS.
# `false` existe para o desenvolvimento local, que não tem TLS — o boot recusa
# subir com isto desligado quando NODE_ENV=production.
COOKIE_SEGURO=false
