# Ambiente
NODE_ENV=development
PORT=3000

# Banco — o compose local sobe exatamente estas credenciais
DATABASE_URL=postgresql://pharmopet:pharmopet@localhost:5432/pharmopet

# Origens liberadas para o navegador, separadas por vírgula.
# Vazio = nenhuma origem de browser é aceita.
ALLOWED_ORIGINS=http://localhost:5173

# Quanto tempo a sessão vale sem renovação. Doze horas cobrem um plantão.
SESSAO_DURACAO_HORAS=12

# Marca o cookie de sessão como Secure, e aí o navegador só o envia por HTTPS.
# `false` existe para o desenvolvimento local, que não tem TLS — o boot recusa
# subir com isto desligado quando NODE_ENV=production.
COOKIE_SEGURO=false

# Envio de e-mail, para a recuperação de senha (ADR 0016).
#
# As três juntas ou nenhuma: faltando qualquer uma, "esqueci a senha" passa a
# responder que não está configurada — em vez de aceitar o pedido e deixar a
# pessoa esperando um e-mail que nunca sai.
#
# A chave é credencial de envio em nome do domínio da farmácia: vem do ambiente
# do servidor, nunca de arquivo versionado.
# RESEND_API_KEY=
# EMAIL_REMETENTE=PharmoPet <naoresponda@exemplo.com.br>

# Raiz pública do front, para montar o link do e-mail. Sem ela o link sairia
# relativo, e não há navegador que abra isso a partir de uma caixa de entrada.
# URL_PUBLICA=http://localhost:5173
