  "info": {
    "title": "PharmoPet API",
    "description": "Prescrição e manipulação veterinária",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "EntrarDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "senha": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "senha"
        ]
      },
      "EuDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "papel": {
            "type": "string",
            "enum": [
              "ADMIN",
              "VETERINARIO",
              "FARMACIA"
            ]
          },
          "crmv": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "nome",
          "email",
          "papel",
          "crmv"
        ]
      },
      "TrocarSenhaDto": {
        "type": "object",
        "properties": {
          "senhaAtual": {
            "type": "string",
            "minLength": 1
          },
          "senhaNova": {
            "type": "string",
            "minLength": 12,
            "maxLength": 200
          }
        },
        "required": [
          "senhaAtual",
          "senhaNova"
        ]
      },
      "CriarUsuarioDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "nome": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "papel": {
            "type": "string",
            "enum": [
              "ADMIN",
              "VETERINARIO",
              "FARMACIA"
            ]
          },
          "senha": {
            "type": "string",
            "minLength": 12,
            "maxLength": 200
          },
          "crmv": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "email",
          "nome",
          "papel",
          "senha"
        ]
      },
      "ListaDeInsumosDto": {
        "type": "object",
        "properties": {
          "insumos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "codigo": {
                  "type": "string"
                },
                "descricao": {
                  "type": "string"
                },
                "controlado": {
                  "type": "boolean"
                },
                "listaDeControle": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "estoque": {
                  "type": "string",
                  "enum": [
                    "disponivel",
                    "em-falta",
                    "desconhecido"
                  ]
                },
                "formasProibidas": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "formaId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "nome": {
                        "type": "string"
                      },
                      "motivo": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "formaId",
                      "nome",
                      "motivo"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "codigo",
                "descricao",
                "controlado",
                "listaDeControle",
                "estoque",
                "formasProibidas"
              ]
            }
          }
        },
        "required": [
          "insumos"
        ]
      },
      "ListaDeFormasDto": {
        "type": "object",
        "properties": {
          "formas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "nome": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "nome"
              ]
            }
          }
        },
        "required": [
          "formas"
        ]
      },
      "PrecificarDto": {
        "type": "object",
        "properties": {
          "formaId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "itens": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "insumoId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "doseMg": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100000
                },
                "quantidade": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                }
              },
              "required": [
                "insumoId",
                "doseMg",
                "quantidade"
              ]
            }
          },
          "paciente": {
            "type": "object",
            "properties": {
              "especie": {
                "type": "string",
                "enum": [
                  "CANINO",
                  "FELINO",
                  "EQUINO",
                  "AVE",
                  "ROEDOR",
                  "REPTIL"
                ]
              },
              "pesoEmGramas": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 2000000
              }
            },
            "required": [
              "especie",
              "pesoEmGramas"
            ]
          }
        },
        "required": [
          "formaId",
          "itens"
        ]
      },
      "OrcamentoDto": {
        "type": "object",
        "properties": {
          "valorFinalEmCentavos": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "forma": {
            "type": "string"
          },
          "avisos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tipo": {
                  "type": "string",
                  "enum": [
                    "sem-estoque",
                    "controlado",
                    "antimicrobiano",
                    "fora-da-faixa",
                    "sem-referencia"
                  ]
                },
                "insumoId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "texto": {
                  "type": "string"
                }
              },
              "required": [
                "tipo",
                "insumoId",
                "texto"
              ]
            }
          },
          "impedimentos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "insumoId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "texto": {
                  "type": "string"
                }
              },
              "required": [
                "insumoId",
                "texto"
              ]
            }
          }
        },
        "required": [
          "valorFinalEmCentavos",
          "forma",
          "avisos",
          "impedimentos"
        ]
      },
      "OrcamentoDetalhadoDto": {
        "type": "object",
        "properties": {
          "valorFinalEmCentavos": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "forma": {
            "type": "string"
          },
          "avisos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tipo": {
                  "type": "string",
                  "enum": [
                    "sem-estoque",
                    "controlado",
                    "antimicrobiano",
                    "fora-da-faixa",
                    "sem-referencia"
                  ]
                },
                "insumoId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "texto": {
                  "type": "string"
                }
              },
              "required": [
                "tipo",
                "insumoId",
                "texto"
              ]
            }
          },
          "impedimentos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "insumoId": {
                  "anyOf": [
                    {
