// Schema do domínio PharmoPet.
//
// As entidades nascem junto com os módulos que as usam — Identidade na fase 2,
// Catálogo na fase 3 — em vez de um schema grande escrito antes dos casos de uso.
// Toda alteração entra por migration versionada, nunca por `db push` em produção.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Papéis do sistema. Instalação única, sem organização — a ADR 0002 fixou isso.
enum Papel {
  /// Administra a instalação: cria usuários, mexe em preço e em catálogo.
  ADMIN
  /// Prescreve. É quem monta a receita e a formulação magistral.
  VETERINARIO
  /// Manipula: vê a fila de pedidos e move o estado da produção.
  FARMACIA
}

/// Quem entra no sistema.
///
/// Sem exclusão física: um usuário desativado precisa continuar existindo para
/// as receitas que ele assinou continuarem tendo autor. `desativadoEm` marca a
/// saída, e o login recusa quem tem essa data preenchida.
model Usuario {
  id        String  @id @default(uuid()) @db.Uuid
  /// Guardado em minúsculas. O índice único só protege de verdade assim: dois
  /// cadastros do mesmo e-mail em caixa diferente seriam duas contas da mesma
  /// pessoa, cada uma com a sua senha.
  email     String  @unique
  nome      String
  papel     Papel
  /// Hash Argon2id, com os parâmetros embutidos no próprio texto. Senha em claro
  /// nunca chega aqui, e o hash nunca sai da API.
  senhaHash String
  /// CRMV de quem prescreve. Nulo para os demais papéis.
  crmv      String?

  desativadoEm DateTime? @db.Timestamptz(3)

  /// Momento a partir do qual toda sessão anterior deixa de valer. É o que faz a
  /// troca de senha derrubar as outras sessões numa escrita só.
  sessoesValidasDesde DateTime @default(now()) @db.Timestamptz(3)

  /// Senhas erradas seguidas. Zera a cada entrada aceita.
  tentativasFalhas Int       @default(0)
  /// Enquanto esta data estiver no futuro, o login recusa até com a senha certa.
  bloqueadoAte     DateTime? @db.Timestamptz(3)

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  sessoes  Sessao[]
  eventos  EventoDeAuditoria[]
  tutores  Tutor[]
  receitas Receita[]

  @@index([papel])
  @@map("usuario")
}

/// Sessão de navegador.
///
/// Sessão em tabela, e não JWT: a ADR 0008 explica por quê — o blueprint exige
/// revogação imediata, e um token assinado só deixa de valer quando expira.
model Sessao {
  id String @id @default(uuid()) @db.Uuid

  usuarioId String  @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// SHA-256 do segredo que viaja no cookie. O segredo não é guardado: um
  /// vazamento desta tabela não entrega a ninguém uma sessão utilizável.
  tokenHash String @unique

  /// Segredo do par anti-CSRF. Vai num cookie legível pelo JavaScript e volta em
  /// cabeçalho; é a conferência dos dois que prova que a chamada saiu da nossa
  /// página, e não de um formulário hospedado em outro site.
  csrfToken String

  expiraEm   DateTime  @db.Timestamptz(3)
  revogadaEm DateTime? @db.Timestamptz(3)

  /// Contexto de origem, para a pessoa reconhecer uma sessão que não é dela.
  ip              String?
  agenteDeUsuario String?

  criadaEm    DateTime @default(now()) @db.Timestamptz(3)
  ultimoUsoEm DateTime @default(now()) @db.Timestamptz(3)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessao")
}

enum AcaoAuditada {
  ENTRADA_ACEITA
  ENTRADA_RECUSADA
  CONTA_BLOQUEADA
  SAIDA
  SENHA_ALTERADA
  USUARIO_CRIADO
  USUARIO_DESATIVADO
  RECEITA_EMITIDA
  RECEITA_CANCELADA
}

/// O que aconteceu, quem fez e quando.
///
/// Só recebe inserção: não existe caminho de escrita que atualize ou apague uma
/// linha daqui. Auditoria que pode ser reescrita não é auditoria.
model EventoDeAuditoria {
  id String @id @default(uuid()) @db.Uuid

  /// Nulo quando não há quem identificar — tentativa de entrada num e-mail que
  /// não existe, por exemplo. O evento importa mesmo sem autor.
  usuarioId String?  @db.Uuid
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  acao AcaoAuditada

  /// O que foi tocado, quando a ação incide sobre algo: "usuario:<id>".
  alvo String?

  /// Contexto do evento. Nunca senha, nunca token, nunca hash.
  detalhe Json?

  ip              String?
  agenteDeUsuario String?

  ocorridoEm DateTime @default(now()) @db.Timestamptz(3)

  @@index([usuarioId, ocorridoEm])
  @@index([acao, ocorridoEm])
  @@map("evento_de_auditoria")
}

// ---------------------------------------------------------------------------
// Catálogo e precificação
//
// Todo valor monetário é inteiro, nunca ponto flutuante — a ADR 0009 explica.
// Duas escalas convivem, e o nome do campo diz qual: centavo para o que a
// pessoa paga, micro-real (10⁻⁶ BRL) para custo por grama, que é pequeno
// demais para caber em centavo sem virar zero.
// ---------------------------------------------------------------------------

/// Matéria-prima que a farmácia manipula.
model Insumo {
  id String @id @default(uuid()) @db.Uuid

  /// Código do sistema da farmácia. É por ele que a equipe se refere ao insumo.
  codigo    String @unique
  descricao String

  /// Custo por grama, em micro-reais.
  custoPorGramaEmMicro             Int
  /// Piso de custo por grama, em micro-reais. Evita vender abaixo da reposição
  /// quando o custo gravado está defasado.
  custoDeReferenciaPorGramaEmMicro Int @default(0)
  /// Multiplicador sobre o custo, em centésimos: 648 é 6,48×.
  markupEmCentesimos               Int

  /// Estoque disponível, em miligramas. Nulo é "não informado", e é diferente
  /// de zero: zero afirma falta, e afirmar falta sem saber enche a tela de aviso
  /// falso — que é como se ensina alguém a ignorar avisos.
  estoqueEmMiligramas Int?

  controlado      Boolean @default(false)
  /// Lista da Portaria 344/98 (A1, A2, B1, C1…) ou ANTIMICROBIANO.
  /// A exigência de receituário depende disto, então não é só rótulo.
  listaDeControle String?

  desativadoEm DateTime? @db.Timestamptz(3)

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  restricoes RestricaoDeForma[]
  faixas     FaixaTerapeutica[]
  prescrito  ItemDaFormulacao[]

  @@index([descricao])
  @@index([controlado])
  @@map("insumo")
}

/// Como a fórmula é entregue: cápsula, biscoito, suspensão, pasta.
model FormaFarmaceutica {
  id String @id @default(uuid()) @db.Uuid

  nome String @unique

  desativadaEm DateTime? @db.Timestamptz(3)

  criadaEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadaEm DateTime @updatedAt @db.Timestamptz(3)

  restricoes  RestricaoDeForma[]
  formulacoes Formulacao[]

  @@map("forma_farmaceutica")
}

/// Insumo que não pode ser manipulado numa forma — "não faz em pasta".
///
/// É restrição técnica da farmácia, não preferência: entra como impedimento no
/// orçamento, e não como aviso.
model RestricaoDeForma {
  id String @id @default(uuid()) @db.Uuid

  insumoId String @db.Uuid
  insumo   Insumo @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  formaId String            @db.Uuid
  forma   FormaFarmaceutica @relation(fields: [formaId], references: [id], onDelete: Cascade)

  /// Por que não pode. Aparece para quem prescreve.
  motivo String

  criadaEm DateTime @default(now()) @db.Timestamptz(3)

  @@unique([insumoId, formaId])
  @@index([insumoId])
  @@map("restricao_de_forma")
}

enum Especie {
  CANINO
  FELINO
  EQUINO
  AVE
  ROEDOR
  REPTIL
}

/// Dose recomendada de um insumo, por espécie e faixa de peso.
///
/// Peso em gramas e dose em microgramas por quilo, ambos inteiros: meio quilo
/// de calopsita não deveria virar 0,5 em ponto flutuante no meio de um cálculo
/// de dose.
model FaixaTerapeutica {
  id String @id @default(uuid()) @db.Uuid

  insumoId String @db.Uuid
  insumo   Insumo @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  especie Especie

  /// Nulos significam "sem limite deste lado".
  pesoMinimoEmGramas Int?
  pesoMaximoEmGramas Int?

  doseMinimaEmMicrogramasPorKg Int
  doseMaximaEmMicrogramasPorKg Int

  duracaoMaximaEmDias Int?

  observacao String?

  criadaEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadaEm DateTime @updatedAt @db.Timestamptz(3)

  @@index([insumoId, especie])
  @@map("faixa_terapeutica")
}

/// Condições comerciais da instalação.
///
/// Uma linha só, presa por `id`. Hoje a farmácia pratica as mesmas condições
/// para todo mundo; quando houver cadastro de clínica com termos negociados,
/// isto vira uma linha por clínica — e o motor de precificação não muda, porque
/// já recebe as condições por parâmetro.
model CondicoesComerciais {
  /// Sempre "padrao". Um enum de um valor só, para o banco garantir a linha única.
  id String @id @default("padrao")

  taxaDeManipulacaoEmCentavos   Int @default(0)
  custoDeEmbalagensEmCentavos   Int @default(0)
  /// Desconto em pontos-base: 4000 é 40%.
  descontoEmPontosBase          Int @default(0)
  adicionalDeEntregaEmCentavos  Int @default(0)
  /// Cobrado só quando a forma é biscoito ou petisco.
  adicionalDeBiscoitoEmCentavos Int @default(0)

  atualizadasEm DateTime @updatedAt @db.Timestamptz(3)

  @@map("condicoes_comerciais")
}

// ---------------------------------------------------------------------------
// Receituário
//
// Receita não é formulário: é documento. Duas consequências aparecem no modelo.
//
// A primeira é que ela vence, e o prazo depende da lista de controle do que foi
// prescrito — por isso `validaAte` e `prazoEmDias` são gravados, e não
// recalculados na leitura: a regra pode mudar, e a receita de ontem continua
// valendo pelo que valia ontem.
//
// A segunda é que, depois de emitida, não se corrige. Os campos congelados
// (peso, CRMV, preço, código e descrição do insumo) existem por isso: o cadastro
// muda, o documento não. Nome de tutor e de paciente seguem por relação de
// propósito — mudança ali é correção de cadastro, não reescrita do que foi
// prescrito.
// ---------------------------------------------------------------------------

enum Sexo {
  MACHO
  FEMEA
}

/// Quem responde pelo animal, e quem paga.
model Tutor {
  id String @id @default(uuid()) @db.Uuid

  nome String

  /// Só dígitos, conferido pelos dígitos verificadores antes de gravar.
  ///
  /// Nulo porque a consulta vem antes do cadastro completo: exigir CPF para
  /// abrir uma ficha empurraria a equipe a digitar qualquer coisa no campo, que
  /// é pior do que não ter o dado. Único quando existe — duas fichas do mesmo
  /// CPF são a mesma pessoa cadastrada duas vezes.
  cpf String? @unique

  email    String?
  /// Só dígitos, com DDD.
  telefone String?

  /// Endereço em campos, e não em texto livre: entrega precisa de CEP e número,
  /// e extrair isso de uma linha só é adivinhação.
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String? @db.Char(2)

  observacoes String?

  /// Quem abriu a ficha. É por aqui que a visibilidade se resolve: um
  /// veterinário não enxerga a clientela de outro.
  cadastradoPorId String  @db.Uuid
  cadastradoPor   Usuario @relation(fields: [cadastradoPorId], references: [id])

  desativadoEm DateTime? @db.Timestamptz(3)

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  pacientes Paciente[]

  @@index([nome])
  @@index([cadastradoPorId])
  @@map("tutor")
}

/// O animal.
model Paciente {
  id String @id @default(uuid()) @db.Uuid

  tutorId String @db.Uuid
  tutor   Tutor  @relation(fields: [tutorId], references: [id], onDelete: Restrict)

  nome    String
  especie Especie
  raca    String?
  sexo    Sexo?

  castrado Boolean @default(false)

  /// Peso em gramas inteiros, como na faixa terapêutica. Nulo enquanto ninguém
  /// pesou — e peso sem data de aferição não se pode confiar para dosar, por
  /// isso as duas colunas andam juntas.
  pesoEmGramas  Int?
  pesoAferidoEm DateTime? @db.Timestamptz(3)

  nascimentoEm DateTime? @db.Date

  observacoes String?

  /// Óbito em vez de exclusão: as receitas assinadas continuam existindo.
  obitoEm DateTime? @db.Timestamptz(3)

  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  receitas Receita[]

  @@index([tutorId])
  @@index([nome])
  @@map("paciente")
}

enum EstadoDaReceita {
  RASCUNHO
  EMITIDA
  CANCELADA
}

model Receita {
  id String @id @default(uuid()) @db.Uuid

  /// Número legível, para a farmácia e o tutor se referirem à receita.
  ///
  /// Só existe depois de emitida, e vem de uma sequence do Postgres: rascunho
  /// que ninguém emite não gasta número, e `max(numero) + 1` daria o mesmo
  /// número a duas emissões simultâneas.
  numero Int? @unique

  estado EstadoDaReceita @default(RASCUNHO)

  veterinarioId String  @db.Uuid
  veterinario   Usuario @relation(fields: [veterinarioId], references: [id], onDelete: Restrict)

  pacienteId String   @db.Uuid
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)

  /// Congelado na emissão: é o CRMV que estava na assinatura.
  crmvDoVeterinario String?

  /// Congelado na emissão. É contra este peso que a dose foi conferida; ler o
  /// peso de hoje faria uma receita correta parecer errada seis meses depois.
  pesoDoPacienteEmGramas Int?

  emitidaEm   DateTime? @db.Timestamptz(3)
  /// Instante em que deixa de valer, calculado na emissão.
  validaAte   DateTime? @db.Timestamptz(3)
  /// O prazo aplicado e de onde ele saiu, para a receita explicar a si mesma.
  prazoEmDias Int?
  prazoMotivo String?

  canceladaEm          DateTime? @db.Timestamptz(3)
  motivoDoCancelamento String?

  observacoes String?

  criadaEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadaEm DateTime @updatedAt @db.Timestamptz(3)

  formulacoes Formulacao[]

  @@index([veterinarioId, criadaEm])
  @@index([pacienteId])
  @@index([estado])
  @@map("receita")
}

/// Uma fórmula da receita: uma cápsula, um biscoito, uma suspensão.
///
/// Existe como nível próprio porque dois ativos na mesma cápsula e dois ativos
/// em cápsulas separadas são prescrições diferentes, e uma lista plana de itens
/// não sabe dizer qual é qual. É também a unidade que o motor de precificação
/// recebe.
model Formulacao {
  id String @id @default(uuid()) @db.Uuid

  receitaId String  @db.Uuid
  receita   Receita @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  formaId String            @db.Uuid
  forma   FormaFarmaceutica @relation(fields: [formaId], references: [id], onDelete: Restrict)

  /// Congelado na emissão: a forma pode ser renomeada no cadastro.
  formaNome String?

  /// Posologia. Intervalo em horas e duração em dias, ambos inteiros.
  frequenciaHoras Int
  dias            Int
  /// Unidades a manipular. Sai da posologia, mas fica gravado porque o
  /// veterinário pode arredondar para cima — "faça 30 cápsulas".
  quantidade      Int

  /// Como tomar, em texto: "dar com comida", "à noite".
  orientacao String?

  /// Preço congelado na emissão. Nulo no rascunho: preço de rascunho é cotação,
  /// e cotação muda.
  valorEmCentavos Int?

  ordem Int @default(0)

  itens ItemDaFormulacao[]

  @@index([receitaId])
  @@map("formulacao")
}

model ItemDaFormulacao {
  id String @id @default(uuid()) @db.Uuid

  formulacaoId String     @db.Uuid
  formulacao   Formulacao @relation(fields: [formulacaoId], references: [id], onDelete: Cascade)

  insumoId String @db.Uuid
  insumo   Insumo @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  /// Congelados na emissão. O catálogo é reimportado a cada export da farmácia,
  /// e uma descrição corrigida não pode reescrever o que foi prescrito.
  insumoCodigo    String?
  insumoDescricao String?
  /// A lista que determinou o prazo desta receita.
  listaDeControle String?

  /// Dose por unidade manipulada, em microgramas. Inteiro, como no motor.
  dosePorUnidadeEmMicrogramas Int

  ordem Int @default(0)

  @@unique([formulacaoId, insumoId])
  @@index([insumoId])
  @@map("item_da_formulacao")
}
